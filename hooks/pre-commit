#!/bin/bash
# ARCDevTools Pre-commit Hook
# Version: 1.4.0

set -e

# Resolve the *pinned* SwiftLint/SwiftFormat so local results match CI.
# The submodule is usually at ARCDevTools/, but projects may nest it
# (e.g. Tools/ARCDevTools), so locate it rather than hardcoding the path.
REPO_ROOT="$(git rev-parse --show-toplevel)"
ARC_TOOL_ENV="$(find "$REPO_ROOT" -maxdepth 3 -path '*/ARCDevTools/scripts/tool-env.sh' -print -quit 2>/dev/null)"
if [ -n "$ARC_TOOL_ENV" ]; then
  # shellcheck source=/dev/null
  . "$ARC_TOOL_ENV"
else
  SWIFTLINT_BIN="$(command -v swiftlint || true)"
  SWIFTFORMAT_BIN="$(command -v swiftformat || true)"
  arc_tool_warn() { :; }
fi

# Detectar si se está intentando saltar verificaciones
if [ "$SKIP_HOOKS" = "1" ]; then
  echo ""
  echo "========================================================"
  echo "  ADVERTENCIA: Verificaciones de pre-commit desactivadas"
  echo "========================================================"
  echo ""
  echo "  El CI ejecutara estas mismas verificaciones y rechazara"
  echo "  el PR si hay violaciones."
  echo ""
  echo "  Ejecuta 'make lint' o './ARCDevTools/scripts/pr-ready.sh'"
  echo "  para verificar localmente antes de push."
  echo ""
  exit 0
fi

echo "Pre-commit: Verificando calidad de codigo..."

# Detectar archivos Swift staged.
# -z + read -d '' para soportar rutas con espacios, comillas o caracteres
# no ASCII (sin -z, git entrecomilla esos nombres por core.quotePath).
# Bucle while en lugar de mapfile: macOS trae bash 3.2.
STAGED_SWIFT=()
while IFS= read -r -d '' file; do
  STAGED_SWIFT+=("$file")
done < <(git diff --cached --name-only -z --diff-filter=ACM -- '*.swift')

if [ ${#STAGED_SWIFT[@]} -eq 0 ]; then
  echo "  No hay archivos Swift en stage, omitiendo..."
  exit 0
fi

echo "  Archivos a verificar:"
printf '    - %s\n' "${STAGED_SWIFT[@]}"

# 1. SwiftFormat (auto-fix)
if [ -n "$SWIFTFORMAT_BIN" ]; then
  echo ""
  echo "  Aplicando SwiftFormat..."
  arc_tool_warn swiftformat
  "$SWIFTFORMAT_BIN" --config .swiftformat "${STAGED_SWIFT[@]}" 2>&1 | grep -v "running" || true

  # Re-stage archivos formateados.
  # -f porque algunos repos ignoran rutas que sí tienen ficheros trackeados
  # (p. ej. .claude/skills/ con arc-package-validator dentro). Sin -f, `git add`
  # aborta con "paths are ignored", y con `set -e` eso bloquea el commit entero.
  # Es seguro: estos ficheros ya estaban en stage, luego ya están trackeados.
  git add -f -- "${STAGED_SWIFT[@]}"
  echo "  Formato aplicado"
else
  arc_tool_warn swiftformat
fi

# 2. SwiftLint (strict mode)
if [ -n "$SWIFTLINT_BIN" ]; then
  echo ""
  echo "  Ejecutando SwiftLint..."
  arc_tool_warn swiftlint

  # Filter staged files to only those in included paths from .swiftlint.yml
  INCLUDED_PATHS=()
  if [ -f ".swiftlint.yml" ]; then
    while IFS= read -r inc; do
      if [ -n "$inc" ]; then
        INCLUDED_PATHS+=("$inc")
      fi
    done < <(grep -A 100 "^included:" .swiftlint.yml | grep "^  - " | sed 's/^  - //' | tr -d '"' || true)
  fi

  LINT_FILES=()
  if [ ${#INCLUDED_PATHS[@]} -gt 0 ]; then
    for file in "${STAGED_SWIFT[@]}"; do
      for inc in "${INCLUDED_PATHS[@]}"; do
        case "$file" in
          "$inc"/*)
            LINT_FILES+=("$file")
            break
            ;;
        esac
      done
    done
  else
    LINT_FILES=("${STAGED_SWIFT[@]}")
  fi

  if [ ${#LINT_FILES[@]} -eq 0 ]; then
    echo "  No hay archivos Swift en paths incluidos, omitiendo lint..."
  elif "$SWIFTLINT_BIN" lint --config .swiftlint.yml --strict --quiet -- "${LINT_FILES[@]}"; then
    echo "  SwiftLint passed"
  else
    echo ""
    echo "========================================================"
    echo "  SwiftLint encontro violaciones"
    echo "========================================================"
    echo ""
    echo "  Opciones:"
    echo "    1. Corregir las violaciones mostradas arriba"
    echo "    2. Ejecutar 'swiftlint lint --fix' para auto-correccion"
    echo "    3. Usar 'SKIP_HOOKS=1 git commit' para saltar (NO recomendado)"
    echo ""
    echo "  Si saltas el hook, el CI rechazara el PR"
    echo ""
    exit 1
  fi
else
  arc_tool_warn swiftlint
fi

echo ""
echo "Pre-commit completado - Commit permitido"
